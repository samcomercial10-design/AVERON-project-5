# Use TEST keys first. Never commit the real .env file.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
CJ_API_KEY=CJ_REPLACE_ME
# Returned by CJ's Get Access Token API. Used only server-side to verify webhook signatures.
CJ_OPEN_ID=
SITE_URL=http://localhost:4242
PORT=4242

# Stripe TEST -> CJ SANDBOX bridge. Never enables real CJ fulfilment.
CJ_STRIPE_SANDBOX_AUTOMATION=true
CJ_SANDBOX_LOGISTICS=CJPacket Ordinary

# Stripe LIVE -> real CJ fulfilment. Keep both FALSE until the real CJ catalogue mappings,
# logistics and CJ balance have been verified in production.
CJ_LIVE_AUTOMATION=false
# false = create real CJ order only; true = createOrderV2 payType=2 and request CJ balance deduction.
CJ_AUTO_PAY_BALANCE=false
CJ_LIVE_LOGISTICS_DEFAULT=CJPacket Ordinary
CJ_FROM_COUNTRY_CODE=CN

# AVERON private Content Studio
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=12
ADMIN_SECURE_COOKIE=false

# Observability / anomaly alerts
ALERT_SLOW_REQUEST_MS=2500
ALERT_SLOW_DB_MS=250
ALERT_COOLDOWN_MS=60000
# Optional HTTPS endpoint (Slack/Discord/custom webhook adapter) that receives anomaly JSON.
ALERT_WEBHOOK_URL=
# Optional custom database location; useful for tests/deploy layouts.
AVERON_DB_PATH=

# Supabase customer accounts (Authentication > URL / API keys)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
# Set true behind HTTPS in production. Production/SITE_URL=https also enables it automatically.
CUSTOMER_SECURE_COOKIE=false
